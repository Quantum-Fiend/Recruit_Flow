# Local Docker Compose settings only. Use unique, managed secrets in production.
POSTGRES_USER=recruitflow
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=recruitflow
POSTGRES_PORT=5432

DATABASE_URL=postgresql://recruitflow:local-development-only@db:5432/recruitflow?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret-before-production
AUTH_TRUST_HOST=true
OPENAI_API_KEY=
OPENAI_RESUME_MODEL=gpt-4.1-mini
RESEND_API_KEY=
EMAIL_FROM=
APP_PORT=3000
