# Copy to .env and replace the marked values before starting Docker Compose.
POSTGRES_USER=recruitflow
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_DB=recruitflow

APP_PORT=3000
APP_BIND_ADDRESS=127.0.0.1
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
AUTH_TRUST_HOST=true

# Optional integrations. Leave blank to disable.
OPENAI_API_KEY=
OPENAI_RESUME_MODEL=gpt-4.1-mini
RESEND_API_KEY=
EMAIL_FROM=
